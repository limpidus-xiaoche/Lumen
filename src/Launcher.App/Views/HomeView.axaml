<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Launcher.App.Views.HomeView">

  <UserControl.Styles>
    <!-- 超大启动按钮：暗紫底 + 紫色微光描边 -->
    <Style Selector="Button.launch">
      <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentGlow}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Width" Value="330" />
      <Setter Property="Height" Value="72" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    BoxShadow="0 0 26 0 #73A275F5">
              <ContentPresenter Content="{TemplateBinding Content}"
                                Foreground="{TemplateBinding Foreground}"
                                FontSize="{TemplateBinding FontSize}"
                                FontWeight="{TemplateBinding FontWeight}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style Selector="Button.launch:pointerover">
      <Setter Property="Background" Value="#3B2566" />
      <Setter Property="Foreground" Value="#E3D3FF" />
    </Style>
    <Style Selector="Button.launch:pressed">
      <Setter Property="Background" Value="#2E1F4D" />
      <Setter Property="Opacity" Value="0.9" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <!-- 末影龙飞行剪影水印（极淡，仅作氛围，不遮挡内容） -->
    <Viewbox Width="460" Height="250"
             HorizontalAlignment="Right"
             VerticalAlignment="Bottom"
             Margin="0,0,-28,-34"
             Opacity="0.05"
             IsHitTestVisible="False">
      <Canvas Width="300" Height="160">
        <Path Fill="{DynamicResource AccentBrush}"
              Data="M145 78 L48 18 L40 30 L72 62 L30 58 L70 92 L138 96 Z M158 78 L255 18 L263 30 L231 62 L273 58 L233 92 L165 96 Z M145 78 L128 52 L106 44 L112 56 L132 66 L136 84 L130 104 L142 118 L154 104 L162 88 L160 106 L210 124 L262 118 L262 126 L208 132 L156 120 Z" />
      </Canvas>
    </Viewbox>

    <!-- 中央启动区域（毛玻璃卡片：账号区位于启动按钮上方 + 超大启动按钮 + 实例选择） -->
    <Border Width="460"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Padding="28,22"
            CornerRadius="20"
            Background="{DynamicResource GlassBackground}"
            BorderBrush="{DynamicResource GlassBorder}"
            BorderThickness="1"
            BoxShadow="0 12 36 0 #80000000">
      <StackPanel Spacing="10" HorizontalAlignment="Center">

        <!-- 账号区（PCL2 风格，位于启动按钮上方）：登录方式 + 皮肤头像 + 用户名 -->
        <StackPanel Spacing="4" HorizontalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center">
            <RadioButton Classes="mode-pill" GroupName="AuthMode"
                         Content="离线" Padding="14,6" FontSize="13"
                         IsChecked="{Binding $parent[Window].DataContext.Accounts.OfflineMode}" />
            <RadioButton Classes="mode-pill" GroupName="AuthMode"
                         Content="正版" Padding="14,6" FontSize="13"
                         IsChecked="{Binding $parent[Window].DataContext.Accounts.OnlineMode}" />
          </StackPanel>
          <Border Width="64" Height="64" CornerRadius="10"
                  Background="{DynamicResource ContentBackground}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  ClipToBounds="True"
                  HorizontalAlignment="Center">
            <Image Source="{Binding $parent[Window].DataContext.Accounts.Avatar}"
                   RenderOptions.BitmapInterpolationMode="None"
                   Stretch="UniformToFill" />
          </Border>
          <TextBlock Text="{Binding $parent[Window].DataContext.Accounts.Username}"
                     FontSize="13" FontWeight="SemiBold"
                     HorizontalAlignment="Center"
                     Foreground="{DynamicResource TextPrimary}" />
        </StackPanel>

        <Button Classes="launch"
                Command="{Binding LaunchCommand}"
                Content="启动游戏" />

        <TextBlock Text="{Binding VersionText}"
                   FontSize="15"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource TextSecondary}" />

        <!-- 实例选择 + 版本设置（并列的双按钮行） -->
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
          <ComboBox ItemsSource="{Binding Instances}"
                    SelectedItem="{Binding SelectedInstance}"
                    Width="210" Height="40" FontSize="13"
                    VerticalContentAlignment="Center">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <Button Content="版本设置"
                  Command="{Binding OpenVersionSettingsCommand}"
                  Width="112" Height="40"
                  Padding="0"
                  CornerRadius="10"
                  FontSize="13"
                  HorizontalContentAlignment="Center"
                  Background="{DynamicResource CardBackground}"
                  Foreground="{DynamicResource TextPrimary}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1" />
        </StackPanel>

        <TextBlock Text="{Binding StatusText}"
                   FontSize="12"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource TextMuted}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
