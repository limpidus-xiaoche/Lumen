<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Launcher.App.Views.HomeView">
  <StackPanel Margin="28" Spacing="14">
    <TextBlock Text="首页" FontSize="26" FontWeight="Bold" />
    <TextBlock Text="{Binding StatusText}" />
    <ProgressBar Value="{Binding InstallProgress}" Maximum="100" Height="8" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="刷新快照" Command="{Binding RefreshCommand}" />
      <Button Content="模拟安装" Command="{Binding SimulateInstallCommand}" />
    </StackPanel>
  </StackPanel>
</UserControl>
