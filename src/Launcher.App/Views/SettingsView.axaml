<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Launcher.App.Views.SettingsView">
  <StackPanel Margin="28" Spacing="12">
    <TextBlock Text="设置" FontSize="26" FontWeight="Bold" />

    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Text="最大内存 (MB)" VerticalAlignment="Center" />
      <TextBox Text="{Binding MaxMemoryMb}" Width="120" />
      <Button Content="保存设置" Command="{Binding SaveCommand}" />
    </StackPanel>
    <TextBlock Text="{Binding StatusText}" Opacity="0.7" />

    <Separator Margin="0,8" />
    <TextBlock Text="Java" FontSize="18" FontWeight="SemiBold" />
    <Button Content="刷新 Java 列表" Command="{Binding LoadJavasCommand}" HorizontalAlignment="Left" />
    <TextBlock Text="{Binding JavaStatusText}" Opacity="0.7" />
    <ScrollViewer Height="260">
      <ItemsControl ItemsSource="{Binding Javas}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Padding="10" Margin="0,3" Background="#1B1E26" CornerRadius="6">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Path}" FontFamily="Consolas" />
                <TextBlock Text="{Binding Vendor}" Opacity="0.6" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </StackPanel>
</UserControl>
