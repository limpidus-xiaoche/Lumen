<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Launcher.App.Views.LogsView">
  <StackPanel Margin="28" Spacing="12">
    <TextBlock Text="日志" FontSize="26" FontWeight="Bold" />
    <TextBlock Text="{Binding StatusText}" />
    <Button Content="加载日志" Command="{Binding LoadCommand}" />
    <ItemsControl ItemsSource="{Binding Files}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding}" Padding="0,4" FontFamily="Consolas" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
