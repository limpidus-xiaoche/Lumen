<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Launcher.App.Views.VersionSettingsView">
  <UserControl.Styles>
    <Style Selector="RadioButton.cat">
      <Setter Property="Padding" Value="22,11" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border Background="{TemplateBinding Background}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter Content="{TemplateBinding Content}"
                                Foreground="{TemplateBinding Foreground}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style Selector="RadioButton.cat:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="RadioButton.cat:checked">
      <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentGlow}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Margin="28,20,28,24" Spacing="16" MaxWidth="620" HorizontalAlignment="Left">

      <!-- 页头：返回 + 标题 + 版本标识 -->
      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <Button Content="←" Command="{Binding BackCommand}" Width="32" Height="32"
                FontSize="15" CornerRadius="8"
                Background="Transparent" Foreground="{DynamicResource TextSecondary}" />
        <TextBlock Text="版本设置" FontSize="24" FontWeight="Bold"
                   VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" />
        <TextBlock Text="{Binding VersionText}" FontSize="12"
                   VerticalAlignment="Center" Foreground="{DynamicResource AccentGlow}" />
      </StackPanel>

      <!-- 横向分类（大按钮式，间距一致） -->
      <ListBox ItemsSource="{Binding Categories}"
               SelectedItem="{Binding SelectedCategory}"
               HorizontalAlignment="Left"
               Background="Transparent" BorderThickness="0" Padding="0">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="10" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
          </Style>
          <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
          </Style>
          <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentGlow}" />
          </Style>
        </ListBox.Styles>
      </ListBox>

      <!-- 概览 -->
      <Border IsVisible="{Binding IsOverview}"
              Background="{DynamicResource CardBackground}" CornerRadius="10"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="18">
        <StackPanel Spacing="12">
          <StackPanel Spacing="6">
            <TextBlock Text="版本名" FontSize="12" Foreground="{DynamicResource TextMuted}" />
            <TextBox Text="{Binding VersionName}" FontSize="14" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="游戏目录" FontSize="12" Foreground="{DynamicResource TextMuted}" />
            <TextBlock Text="{Binding GameDirText}" FontFamily="Consolas" FontSize="12"
                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondary}" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="版本文件夹" Command="{Binding OpenVersionFolderCommand}"
                    Padding="14,8" CornerRadius="8" FontSize="12" />
            <Button Content="存档文件夹" Command="{Binding OpenSavesFolderCommand}"
                    Padding="14,8" CornerRadius="8" FontSize="12" />
            <Button Content="Mod 文件夹" Command="{Binding OpenModsFolderCommand}"
                    Padding="14,8" CornerRadius="8" FontSize="12" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- 启动 -->
      <Border IsVisible="{Binding IsLaunch}"
              Background="{DynamicResource CardBackground}" CornerRadius="10"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="18">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="110,*" VerticalAlignment="Center">
            <TextBlock Grid.Column="0" Text="最大内存" FontSize="13"
                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <TextBox Text="{Binding MemoryMb}" Width="110" FontSize="13" />
              <TextBlock Text="MB" VerticalAlignment="Center" FontSize="12"
                         Foreground="{DynamicResource TextMuted}" />
            </StackPanel>
          </Grid>

          <Grid ColumnDefinitions="110,*" VerticalAlignment="Center">
            <TextBlock Grid.Column="0" Text="隔离方式" FontSize="13"
                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Isolations}"
                      SelectedItem="{Binding SelectedIsolation}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Title}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>

          <!-- Java 环境：显示版本与文件位置 -->
          <Grid ColumnDefinitions="110,*" VerticalAlignment="Center">
            <TextBlock Grid.Column="0" Text="Java 环境" FontSize="13"
                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Javas}"
                      SelectedItem="{Binding SelectedJava}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Spacing="1">
                    <TextBlock Text="{Binding Title}" FontSize="13" />
                    <TextBlock Text="{Binding Path}" FontSize="10"
                               TextTrimming="CharacterEllipsis" Opacity="0.6" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>

          <TextBlock Text="{Binding SelectedJava.Path}" FontFamily="Consolas" FontSize="11"
                     TextTrimming="CharacterEllipsis" Margin="110,0,0,0"
                     Foreground="{DynamicResource TextMuted}" />
        </StackPanel>
      </Border>

      <!-- Mod 管理 -->
      <StackPanel IsVisible="{Binding IsMods}" Spacing="10">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Button Content="添加模组" Click="OnAddModClick"
                  Padding="16,8" CornerRadius="8" FontSize="12"
                  Background="{DynamicResource AccentBrush}" Foreground="#F4FFFD" />
          <Button Content="刷新列表" Command="{Binding RefreshModsCommand}"
                  Padding="14,8" CornerRadius="8" FontSize="12" />
          <TextBlock Text="{Binding StatusText}" FontSize="12" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextMuted}" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Mods}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{DynamicResource CardBackground}" CornerRadius="8"
                      BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                      Padding="12,10" Margin="0,0,0,8">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">

                  <!-- 模组图标（取不到时用首字母占位） -->
                  <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8"
                          Background="{DynamicResource ContentBackground}"
                          BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                          ClipToBounds="True">
                    <Grid>
                      <Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}"
                             Stretch="UniformToFill" />
                      <TextBlock Text="{Binding Initial}" IsVisible="{Binding !HasIcon}"
                                 FontSize="16" FontWeight="SemiBold"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextMuted}" />
                    </Grid>
                  </Border>

                  <StackPanel Grid.Column="1" Spacing="2" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="13"
                               Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock Text="{Binding VersionText}" FontSize="11"
                               Foreground="{DynamicResource TextMuted}" />
                  </StackPanel>

                  <Button Grid.Column="2" Content="禁用"
                          IsVisible="{Binding Enabled}"
                          Command="{Binding $parent[UserControl].DataContext.ToggleModCommand}"
                          CommandParameter="{Binding}"
                          Padding="12,6" Margin="8,0" CornerRadius="7" FontSize="12" />

                  <Button Grid.Column="2" Content="启用"
                          IsVisible="{Binding !Enabled}"
                          Command="{Binding $parent[UserControl].DataContext.ToggleModCommand}"
                          CommandParameter="{Binding}"
                          Padding="12,6" Margin="8,0" CornerRadius="7" FontSize="12"
                          Background="{DynamicResource AccentSoft}"
                          Foreground="{DynamicResource AccentGlow}" />

                  <Button Grid.Column="3" Content="删除"
                          Command="{Binding $parent[UserControl].DataContext.DeleteModCommand}"
                          CommandParameter="{Binding}"
                          Padding="12,6" CornerRadius="7" FontSize="12"
                          Background="Transparent" Foreground="#E06C6C" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- 保存 + 状态（概览 / 启动 页显示） -->
      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"
                  IsVisible="{Binding !IsMods}">
        <Button Content="保存设置" Command="{Binding SaveCommand}"
                Padding="22,10" CornerRadius="10" FontSize="13" FontWeight="SemiBold"
                Background="{DynamicResource AccentBrush}" Foreground="#F4FFFD" />
        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" FontSize="12"
                   Foreground="{DynamicResource TextMuted}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
