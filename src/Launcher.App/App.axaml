<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Launcher.App.ViewModels"
             xmlns:views="using:Launcher.App.Views"
             x:Class="Launcher.App.App"
             RequestedThemeVariant="Dark">
  <Application.DataTemplates>
    <DataTemplate DataType="vm:HomeViewModel">
      <views:HomeView />
    </DataTemplate>
    <DataTemplate DataType="vm:InstancesViewModel">
      <views:InstancesView />
    </DataTemplate>
    <DataTemplate DataType="vm:DownloadViewModel">
      <views:DownloadView />
    </DataTemplate>
    <DataTemplate DataType="vm:AccountsViewModel">
      <views:AccountsView />
    </DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel">
      <views:SettingsView />
    </DataTemplate>
    <DataTemplate DataType="vm:LogsViewModel">
      <views:LogsView />
    </DataTemplate>
  </Application.DataTemplates>

  <!-- 双主题色板：界面所有颜色都从这里取，切换主题时全局自动换肤 -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>

        <!-- 深色主题（默认）：低饱和深灰蓝 + 克制的科技蓝点缀 -->
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="SidebarBackground" Color="#12141A" />
          <SolidColorBrush x:Key="WindowBackground" Color="#0F1116" />
          <SolidColorBrush x:Key="ContentBackground" Color="#14171E" />
          <SolidColorBrush x:Key="CardBackground" Color="#181C24" />
          <SolidColorBrush x:Key="HoverBrush" Color="#1A2029" />
          <SolidColorBrush x:Key="BorderBrush" Color="#232936" />
          <SolidColorBrush x:Key="TextPrimary" Color="#E8EAED" />
          <SolidColorBrush x:Key="TextSecondary" Color="#A0A8B0" />
          <SolidColorBrush x:Key="TextMuted" Color="#6E7782" />
          <SolidColorBrush x:Key="AccentBrush" Color="#2BD4C4" />
          <SolidColorBrush x:Key="AccentSoft" Color="#1A4A42" />
          <SolidColorBrush x:Key="AccentGlow" Color="#57E5D5" />
        </ResourceDictionary>

        <!-- 浅色主题：干净白灰 + 同系青 -->
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="SidebarBackground" Color="#EFF2F6" />
          <SolidColorBrush x:Key="WindowBackground" Color="#F5F7FA" />
          <SolidColorBrush x:Key="ContentBackground" Color="#FAFBFC" />
          <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="HoverBrush" Color="#E7EBF0" />
          <SolidColorBrush x:Key="BorderBrush" Color="#DDE2E8" />
          <SolidColorBrush x:Key="TextPrimary" Color="#1B2230" />
          <SolidColorBrush x:Key="TextSecondary" Color="#5C6570" />
          <SolidColorBrush x:Key="TextMuted" Color="#8B93A0" />
          <SolidColorBrush x:Key="AccentBrush" Color="#0E9C8F" />
          <SolidColorBrush x:Key="AccentSoft" Color="#D8F0EB" />
          <SolidColorBrush x:Key="AccentGlow" Color="#12ADA0" />
        </ResourceDictionary>

      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
  </Application.Styles>
</Application>
