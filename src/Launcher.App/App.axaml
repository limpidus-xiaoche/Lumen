<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Launcher.App.ViewModels"
             xmlns:views="using:Launcher.App.Views"
             x:Class="Launcher.App.App"
             RequestedThemeVariant="Dark">
  <Application.DataTemplates>
    <DataTemplate DataType="vm:HomeViewModel">
      <views:HomeView />
    </DataTemplate>
    <DataTemplate DataType="vm:InstancesViewModel">
      <views:InstancesView />
    </DataTemplate>
    <DataTemplate DataType="vm:DownloadViewModel">
      <views:DownloadView />
    </DataTemplate>
    <DataTemplate DataType="vm:AccountsViewModel">
      <views:AccountsView />
    </DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel">
      <views:SettingsView />
    </DataTemplate>
    <DataTemplate DataType="vm:VersionSettingsViewModel">
      <views:VersionSettingsView />
    </DataTemplate>
    <DataTemplate DataType="vm:MoreViewModel">
      <views:MoreView />
    </DataTemplate>
    <DataTemplate DataType="vm:LogsViewModel">
      <views:LogsView />
    </DataTemplate>
    <DataTemplate DataType="vm:TaskCenterViewModel">
      <views:TaskCenterView />
    </DataTemplate>
  </Application.DataTemplates>

  <!-- 双主题色板：界面所有颜色都从这里取，切换主题时全局自动换肤 -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>

        <!-- 深色主题（默认）：末影暗黑 —— 炭黑底 + 暗紫主题色 -->
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="SidebarBackground" Color="#120E18" />
          <SolidColorBrush x:Key="WindowBackground" Color="#0D0A12" />
          <SolidColorBrush x:Key="ContentBackground" Color="#15101D" />
          <SolidColorBrush x:Key="CardBackground" Color="#1B1426" />
          <SolidColorBrush x:Key="HoverBrush" Color="#241A33" />
          <SolidColorBrush x:Key="BorderBrush" Color="#33264A" />
          <SolidColorBrush x:Key="TextPrimary" Color="#F0ECF7" />
          <SolidColorBrush x:Key="TextSecondary" Color="#B4A9C7" />
          <SolidColorBrush x:Key="TextMuted" Color="#7C7190" />
          <SolidColorBrush x:Key="AccentBrush" Color="#A275F5" />
          <SolidColorBrush x:Key="AccentSoft" Color="#2E1F4D" />
          <SolidColorBrush x:Key="AccentGlow" Color="#C9A7FF" />
          <!-- 毛玻璃卡片：半透明紫黑 + 淡紫描边 -->
          <SolidColorBrush x:Key="GlassBackground" Color="#9E1C1428" />
          <SolidColorBrush x:Key="GlassBorder" Color="#3DA275F5" />
          <SolidColorBrush x:Key="GlassShadow" Color="#99000000" />
          <!-- 列表选中态统一走暗紫，覆盖 FluentTheme 默认蓝色 -->
          <SolidColorBrush x:Key="ListBoxItemBackgroundSelected" Color="#33A275F5" />
          <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPointerOver" Color="#40A275F5" />
          <SolidColorBrush x:Key="ListBoxItemForegroundSelected" Color="#C9A7FF" />
        </ResourceDictionary>

        <!-- 浅色主题：干净白灰 + 同系紫 -->
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="SidebarBackground" Color="#F1EEF6" />
          <SolidColorBrush x:Key="WindowBackground" Color="#F7F4FB" />
          <SolidColorBrush x:Key="ContentBackground" Color="#FCFAFF" />
          <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="HoverBrush" Color="#ECE6F5" />
          <SolidColorBrush x:Key="BorderBrush" Color="#DFD6EC" />
          <SolidColorBrush x:Key="TextPrimary" Color="#221A30" />
          <SolidColorBrush x:Key="TextSecondary" Color="#5E5470" />
          <SolidColorBrush x:Key="TextMuted" Color="#8C829E" />
          <SolidColorBrush x:Key="AccentBrush" Color="#7A4DE0" />
          <SolidColorBrush x:Key="AccentSoft" Color="#E9DFFF" />
          <SolidColorBrush x:Key="AccentGlow" Color="#8B5CF6" />
          <SolidColorBrush x:Key="GlassBackground" Color="#CCFFFFFF" />
          <SolidColorBrush x:Key="GlassBorder" Color="#407A4DE0" />
          <SolidColorBrush x:Key="GlassShadow" Color="#22000000" />
          <SolidColorBrush x:Key="ListBoxItemBackgroundSelected" Color="#337A4DE0" />
          <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPointerOver" Color="#407A4DE0" />
          <SolidColorBrush x:Key="ListBoxItemForegroundSelected" Color="#5B32B8" />
        </ResourceDictionary>

      </ResourceDictionary.ThemeDictionaries>

      <!-- 主区域右上角的暗紫环境光，营造末影虚空感 -->
      <RadialGradientBrush x:Key="AmbientGlow" Center="78%,0%" RadiusX="0.85" RadiusY="0.85">
        <GradientStop Color="#4A4B2A83" Offset="0" />
        <GradientStop Color="#00000000" Offset="1" />
      </RadialGradientBrush>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!-- 下拉框统一走暗色卡片配色，避免 Fluent 默认白底破坏暗黑风格 -->
    <Style Selector="ComboBox">
      <Setter Property="Background" Value="{DynamicResource CardBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="ComboBox:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="ProgressBar">
      <Setter Property="Foreground" Value="#8B5CF6" />
      <Setter Property="Background" Value="#2A1F45" />
    </Style>
  </Application.Styles>
</Application>
