<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="Launcher.App.MainWindow"
        Title="Lumen"
        Width="820"
        Height="560"
        MinWidth="700"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="52"
        WindowDecorations="None"
        Background="{DynamicResource WindowBackground}">
  <Window.Styles>
    <!-- 账号区登录方式 pill（离线/正版）：选中项青色高亮 -->
    <Style Selector="RadioButton.mode-pill">
      <Setter Property="Padding" Value="18,8" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border Background="{TemplateBinding Background}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                Foreground="{TemplateBinding Foreground}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style Selector="RadioButton.mode-pill:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="RadioButton.mode-pill:checked">
      <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentGlow}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- 自定义标题栏窗口控制按钮 -->
    <Style Selector="Button.win-btn">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="52" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}">
              <ContentPresenter Content="{TemplateBinding Content}"
                                Foreground="{TemplateBinding Foreground}"
                                FontSize="{TemplateBinding FontSize}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style Selector="Button.win-btn:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="Button.win-btn-close:pointerover">
      <Setter Property="Background" Value="#C42B1C" />
      <Setter Property="Foreground" Value="White" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="52,*">

    <!-- 自定义标题栏（PCL2 风格：无系统标题栏，Logo 居左，账号区+关闭按钮居右） -->
    <Border Grid.Row="0" Background="{DynamicResource SidebarBackground}"
            chrome:WindowDecorationProperties.ElementRole="TitleBar">
      <DockPanel LastChildFill="False">

        <!-- 左侧：作者标识（简洁两行：品牌 + 定位） -->
        <StackPanel DockPanel.Dock="Left" Margin="16,0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Width="14" Height="14" CornerRadius="3" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
          <StackPanel VerticalAlignment="Center" Spacing="-2">
            <TextBlock Text="麦谷Limpidus" FontSize="16" FontWeight="Bold"
                       Foreground="{DynamicResource AccentGlow}" />
            <TextBlock Text="启动器" FontSize="11" FontWeight="Medium"
                       Foreground="{DynamicResource TextSecondary}" />
          </StackPanel>
        </StackPanel>

        <!-- 右侧：最小化 + 关闭按钮 -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="0">
          <Button x:Name="BtnMin" Classes="win-btn" Content="─"
                  chrome:WindowDecorationProperties.ElementRole="DecorationsElement" />
          <Button x:Name="BtnClose" Classes="win-btn win-btn-close" Content="×"
                  chrome:WindowDecorationProperties.ElementRole="DecorationsElement" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- 主区：左侧导航 + 右侧页面 -->
    <Grid Grid.Row="1" ColumnDefinitions="172,*">

      <!-- 左侧导航栏（PCL2 风格：竖排大按钮） -->
      <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}">
        <DockPanel>
          <!-- 三大导航按钮：启动 / 下载 / 设置 -->
          <ListBox DockPanel.Dock="Top"
                   Margin="10,26,10,0"
                   ItemsSource="{Binding Pages}"
                   SelectedItem="{Binding SelectedPage}"
                   Background="Transparent"
                   BorderThickness="0">
            <ListBox.ItemContainerTheme>
              <ControlTheme TargetType="ListBoxItem">
                <Setter Property="Padding" Value="22,16" />
                <Setter Property="Margin" Value="4,8" />
                <Setter Property="FontSize" Value="17" />
                <Setter Property="MinHeight" Value="52" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border Background="{TemplateBinding Background}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Padding="{TemplateBinding Padding}"
                              BorderBrush="{DynamicResource AccentBrush}"
                              BorderThickness="0">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                      </Border>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
                <Style Selector="^:pointerover">
                  <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                </Style>
                <Style Selector="^:selected">
                  <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                  <Setter Property="Foreground" Value="{DynamicResource AccentGlow}" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                </Style>
              </ControlTheme>
            </ListBox.ItemContainerTheme>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Title}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- 底部：任务中心 / 更多入口 + 版本信息 -->
          <StackPanel DockPanel.Dock="Bottom" Margin="10,0,10,16" Spacing="4">
            <Button Content="任务"
                    Command="{Binding ShowTasksCommand}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Padding="22,16"
                    Margin="4,8"
                    MinHeight="52"
                    CornerRadius="12"
                    FontSize="17"
                    Background="Transparent"
                    Foreground="{DynamicResource TextSecondary}">
              <Button.Styles>
                <Style Selector="Button:pointerover">
                  <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                </Style>
              </Button.Styles>
            </Button>

            <Button Content="更多"
                    Command="{Binding ShowMoreCommand}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Padding="22,16"
                    Margin="4,8"
                    MinHeight="52"
                    CornerRadius="12"
                    FontSize="17"
                    Background="Transparent"
                    Foreground="{DynamicResource TextSecondary}">
              <Button.Styles>
                <Style Selector="Button:pointerover">
                  <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                </Style>
              </Button.Styles>
            </Button>

            <TextBlock Text="Lumen 0.1 · M2"
                       Margin="26,0,0,0"
                       FontSize="11"
                       Opacity="0.45"
                       Foreground="{DynamicResource TextMuted}" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- 右侧页面内容 -->
      <Border Grid.Column="1" Background="{DynamicResource ContentBackground}">
        <Grid>
          <ContentControl Content="{Binding CurrentPage}" Margin="8" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
