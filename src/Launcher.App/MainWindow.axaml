<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:Launcher.App.Shell"
        x:Class="Launcher.App.MainWindow"
        Title="Lumen"
        WindowStartupLocation="CenterScreen"
        WindowState="FullScreen"
        WindowDecorations="None"
        CanResize="False"
        Background="#05030A">
  <!-- 默认沉浸式 Shell；F2 或左上角「经典视图」按钮切换到 ClassicShell（PCL 风格布局）。 -->
  <Grid>
    <shell:ImmersiveShell x:Name="Immersive" />
    <shell:ClassicShell x:Name="Classic" IsVisible="False" />
  </Grid>
</Window>
