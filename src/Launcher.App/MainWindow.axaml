<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Launcher.App.MainWindow"
        Title="Lumen"
        Width="1080"
        Height="680"
        MinWidth="960"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}">
  <Window.Styles>
    <!-- 账号区登录方式 pill（离线/正版）：选中项青色高亮 -->
    <Style Selector="RadioButton.mode-pill">
      <Setter Property="Padding" Value="14,5" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border Background="{TemplateBinding Background}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                Foreground="{TemplateBinding Foreground}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style Selector="RadioButton.mode-pill:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="RadioButton.mode-pill:checked">
      <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentGlow}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="228,*">

    <!-- 左侧导航栏（PCL2 风格：竖排大按钮） -->
    <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}">
      <DockPanel>

        <!-- 顶部：低调字标 -->
        <StackPanel DockPanel.Dock="Top" Margin="20,22,20,8" Orientation="Horizontal" Spacing="10">
          <Border Width="14" Height="14" CornerRadius="3" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
          <TextBlock Text="Lumen" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- 三大导航按钮：启动 / 下载 / 设置 -->
        <ListBox DockPanel.Dock="Top"
                 Margin="8,14,8,0"
                 ItemsSource="{Binding Pages}"
                 SelectedItem="{Binding SelectedPage}"
                 Background="Transparent"
                 BorderThickness="0">
          <ListBox.ItemContainerTheme>
            <ControlTheme TargetType="ListBoxItem">
              <Setter Property="Padding" Value="18,13" />
              <Setter Property="Margin" Value="2,3" />
              <Setter Property="FontSize" Value="15" />
              <Setter Property="CornerRadius" Value="10" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="0">
                      <ContentPresenter Name="PART_ContentPresenter"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        Foreground="{TemplateBinding Foreground}"
                                        VerticalAlignment="Center" />
                    </Border>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
              <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
              </Style>
              <Style Selector="^:selected">
                <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                <Setter Property="Foreground" Value="{DynamicResource AccentGlow}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Style>
            </ControlTheme>
          </ListBox.ItemContainerTheme>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Title}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- 底部：两位作者低调水印 -->
        <StackPanel DockPanel.Dock="Bottom" Margin="20,0,20,16">
          <TextBlock Text="麦谷 &amp; Limpidus"
                     FontSize="11"
                     Opacity="0.45"
                     Foreground="{DynamicResource TextMuted}" />
          <TextBlock Text="Lumen · MC Launcher"
                     FontSize="9"
                     Opacity="0.3"
                     Foreground="{DynamicResource TextMuted}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- 右侧内容区 -->
    <Border Grid.Column="1" Background="{DynamicResource ContentBackground}">
      <DockPanel>

        <!-- 顶部：账号区（PCL2 风格，右上角） -->
        <Border DockPanel.Dock="Top" Padding="0,10,24,10"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">

            <!-- 登录方式 pill（离线 / 正版） -->
            <Border Background="{DynamicResource CardBackground}"
                    CornerRadius="16"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Padding="3"
                    VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <RadioButton Classes="mode-pill" GroupName="AuthMode"
                             Content="离线"
                             IsChecked="{Binding Accounts.OfflineMode}" />
                <RadioButton Classes="mode-pill" GroupName="AuthMode"
                             Content="正版"
                             IsChecked="{Binding Accounts.OnlineMode}" />
              </StackPanel>
            </Border>

            <!-- 皮肤头像 -->
            <Border Width="52" Height="52" CornerRadius="7"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    VerticalAlignment="Center">
              <Image Source="{Binding Accounts.Avatar}"
                     RenderOptions.BitmapInterpolationMode="None"
                     Stretch="UniformToFill" />
            </Border>

            <!-- 用户名 + 登录状态 -->
            <StackPanel VerticalAlignment="Center" Spacing="1">
              <TextBlock Text="{Binding Accounts.Username}"
                         FontSize="15" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimary}" />
              <TextBlock Text="{Binding Accounts.StatusText}"
                         FontSize="11"
                         Foreground="{DynamicResource TextMuted}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- 页面内容 -->
        <ContentControl Content="{Binding CurrentPage}" Margin="8" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
